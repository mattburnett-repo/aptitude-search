{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aptitude-search.local/schemas/search-queries.schema.json",
  "title": "SearchQueries",
  "type": "object",
  "required": [
    "boolean_queries",
    "linkedin_queries",
    "indeed_queries",
    "search_variants",
    "recommended_next_actions",
    "rationale"
  ],
  "additionalProperties": false,
  "properties": {
    "boolean_queries": {
      "type": "array",
      "items": { "$ref": "#/$defs/queryItem" },
      "minItems": 1
    },
    "linkedin_queries": {
      "type": "array",
      "items": { "$ref": "#/$defs/queryItem" },
      "minItems": 1
    },
    "indeed_queries": {
      "type": "array",
      "items": { "$ref": "#/$defs/queryItem" },
      "minItems": 1
    },
    "search_variants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["variant", "description", "focus"],
        "additionalProperties": false,
        "properties": {
          "variant": {
            "type": "string",
            "enum": ["broad", "balanced", "narrow"]
          },
          "description": { "type": "string" },
          "focus": { "type": "string" }
        }
      },
      "minItems": 3
    },
    "recommended_next_actions": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "rationale": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    }
  },
  "$defs": {
    "queryItem": {
      "type": "object",
      "required": ["label", "query"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string" },
        "query": { "type": "string", "minLength": 3 }
      }
    }
  }
}
