{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aptitude-search.local/schemas/role-family-plan.schema.json",
  "title": "RoleFamilyPlan",
  "type": "object",
  "required": ["recommended_role_families", "rationale"],
  "additionalProperties": false,
  "properties": {
    "recommended_role_families": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/roleFamily" }
    },
    "rationale": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "roleFamily": {
      "type": "object",
      "required": [
        "role_family",
        "fit_reason",
        "supporting_signals",
        "work_modes",
        "search_terms",
        "avoid_terms"
      ],
      "additionalProperties": false,
      "properties": {
        "role_family": {
          "type": "string",
          "minLength": 3
        },
        "fit_reason": {
          "type": "string",
          "minLength": 10
        },
        "supporting_signals": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "work_modes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "search_terms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "type": "string" }
        },
        "avoid_terms": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    }
  }
}
