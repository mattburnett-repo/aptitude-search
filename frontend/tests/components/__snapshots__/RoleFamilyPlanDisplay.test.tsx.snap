// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`RoleFamilyPlanDisplay > matches markup snapshot 1`] = `
<div
  class="role-family-plan"
>
  <p
    class="stage2-lead role-family-lead"
  >
    Select a role to see why we recommend it, keywords to use when searching, preferred work setup, details from your resume that support the fit, and keywords to skip.
  </p>
  <details
    class="collapsible-section role-family-card"
  >
    <summary>
      Role: 
      Solutions / Integration Engineering
    </summary>
    <div
      class="collapsible-section-body"
    >
      <p
        class="role-family-tags-label"
      >
        Why it fits
      </p>
      <p
        class="role-family-fit-reason"
      >
        Repeated API integrations, warehouse systems, and client-facing portal delivery at Riverbend Logistics.
      </p>
      <div
        class="role-family-tags"
      >
        <span
          class="role-family-tags-label"
        >
          Job search keywords
        </span>
        <ul
          class="role-family-tag-list"
        >
          <li>
            solutions engineer
          </li>
          <li>
            integration engineer
          </li>
          <li>
            implementation engineer
          </li>
        </ul>
      </div>
      <div
        class="role-family-tags"
      >
        <span
          class="role-family-tags-label"
        >
          Work setup
        </span>
        <ul
          class="role-family-tag-list"
        >
          <li>
            customer integrations
          </li>
          <li>
            technical discovery
          </li>
          <li>
            API design
          </li>
        </ul>
      </div>
      <div
        class="role-family-tags"
      >
        <span
          class="role-family-tags-label"
        >
          From your resume
        </span>
        <ul
